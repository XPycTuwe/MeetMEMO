<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeetMemo.Contracts\MeetMemo.Contracts.csproj" />
    <ProjectReference Include="..\MeetMemo.Core\MeetMemo.Core.csproj" />
    <ProjectReference Include="..\MeetMemo.Storage\MeetMemo.Storage.csproj" />
    <ProjectReference Include="..\MeetMemo.Audio\MeetMemo.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
