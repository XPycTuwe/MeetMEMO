<Window x:Class="MeetMemo.App.SourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo — приложения и параметры записи"
        Icon="Assets/app.ico"
        Height="620" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF7F8FA">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF667085" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Отметьте приложения для стенографии"
                       FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="#FF1F2937" />
            <TextBlock Text="Галочка «Вести» добавляет кнопки MeetMemo в заголовки окон приложения — запись начинается оттуда. Изображение берётся из выбранного окна, звук — из его процесса и дочерних процессов."
                       Style="{StaticResource Label}" TextWrapping="Wrap" />
            <TextBox x:Name="SearchBox" Margin="0,8,0,8" Padding="6,4"
                     FontFamily="Segoe UI" FontSize="13"
                     TextChanged="OnSearchChanged" />
        </StackPanel>

        <ListView x:Name="WindowList" Grid.Row="1"
                  FontFamily="Segoe UI" FontSize="13"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnRowDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Вести" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsTracked, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          ToolTip="Показывать кнопки MeetMemo в заголовке окон этого приложения" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Приложение" Width="150"
                                    DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="Окно" Width="290"
                                    DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Размер" Width="100"
                                    DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Состояние" Width="95"
                                    DisplayMemberBinding="{Binding StateText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Микрофон" Style="{StaticResource Label}" />
            <ComboBox x:Name="MicrophoneBox" Padding="6,4" FontFamily="Segoe UI" FontSize="13"
                      DisplayMemberPath="Name" />

            <TextBlock Text="Звук встречи" Style="{StaticResource Label}" />
            <ComboBox x:Name="AudioModeBox" Padding="6,4" FontFamily="Segoe UI" FontSize="13" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox x:Name="SaveAudioBox" Content="Сохранять аудиофайлы"
                          FontFamily="Segoe UI" FontSize="13" IsChecked="True" VerticalAlignment="Center" />
                <CheckBox x:Name="AutoShotsBox" Content="Автоснимки окна"
                          FontFamily="Segoe UI" FontSize="13" IsChecked="True"
                          Margin="24,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="WarningText" Style="{StaticResource Label}"
                       Foreground="#FFB54708" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RefreshButton" Content="Обновить список" Padding="14,6" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" Click="OnRefreshClick" />
            <Button x:Name="CancelButton" Content="Отмена" Padding="14,6" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Сохранить" Padding="18,6"
                    FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                    IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
