<Window x:Class="MeetMemo.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo — параметры"
        Icon="Assets/app.ico"
        Height="640" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA">
    <!-- Всё управление в одном окне: раньше приложения, голоса, модели и встречи жили
         четырьмя пунктами меню, и было непонятно, где что искать. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF667085" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Head">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1F2937" />
        </Style>
    </Window.Resources>

    <TabControl Margin="12" FontFamily="Segoe UI" FontSize="13">

        <TabItem Header="Приложения и запись">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Отметьте приложения для стенографии" Style="{StaticResource Head}" />
                    <TextBlock Text="Галочка «Вести» добавляет кнопки MeetMemo в заголовки окон приложения — запись начинается оттуда."
                               Style="{StaticResource Label}" TextWrapping="Wrap" />
                    <TextBox x:Name="SearchBox" Margin="0,4,0,8" Padding="6,4"
                             TextChanged="OnSearchChanged" />
                </StackPanel>

                <ListView x:Name="WindowList" Grid.Row="1" SelectionChanged="OnWindowSelected"
                          MouseDoubleClick="OnWindowDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Вести" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsTracked, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Приложение" Width="160"
                                            DisplayMemberBinding="{Binding ProcessName}" />
                            <GridViewColumn Header="Окно" Width="340"
                                            DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Размер" Width="100"
                                            DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="Состояние" Width="95"
                                            DisplayMemberBinding="{Binding StateText}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="Микрофон" Style="{StaticResource Label}" />
                    <ComboBox x:Name="MicrophoneBox" Padding="6,4" DisplayMemberPath="Name" />

                    <TextBlock Text="Звук встречи" Style="{StaticResource Label}" />
                    <ComboBox x:Name="AudioModeBox" Padding="6,4" />

                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox x:Name="SaveAudioBox" Content="Сохранять аудиофайлы"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,6" />
                        <CheckBox x:Name="AutoShotsBox" Content="Автоснимки окна"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,6" />
                        <CheckBox x:Name="SubtitlesBox" Content="Стенограмма поверх экрана"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,6" />
                        <CheckBox x:Name="ConfirmShotsBox" Content="Спрашивать перед автоснимком"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,6" />
                    </WrapPanel>

                    <TextBlock x:Name="WarningText" Style="{StaticResource Label}"
                               Foreground="#FFB54708" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Обновить список" Padding="14,6" Margin="0,0,8,0"
                            Click="OnRefreshWindows" />
                    <Button Content="Сохранить" Padding="18,6" FontWeight="SemiBold"
                            Click="OnSaveSettings" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Знакомые голоса">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Знакомые голоса" Style="{StaticResource Head}" />
                    <TextBlock x:Name="VoicesSubtitle" Style="{StaticResource Label}" TextWrapping="Wrap" />
                </StackPanel>

                <ListView x:Name="VoiceList" Grid.Row="1" SelectionChanged="OnVoiceSelected">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Имя" Width="190" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Должность" Width="230" DisplayMemberBinding="{Binding Role}" />
                            <GridViewColumn Header="Подтверждений" Width="110"
                                            DisplayMemberBinding="{Binding Confirmations}" />
                            <GridViewColumn Header="Фото" Width="70" DisplayMemberBinding="{Binding HasPhoto}" />
                            <GridViewColumn Header="Запомнен" Width="100" DisplayMemberBinding="{Binding Since}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Имя" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <TextBox x:Name="VoiceNameBox" Padding="6,4" IsEnabled="False" />
                        <TextBlock Text="Должность или роль" Style="{StaticResource Label}" />
                        <TextBox x:Name="VoiceRoleBox" Padding="6,4" IsEnabled="False" />
                    </StackPanel>

                    <!-- Фото человека: оно показывается в карточке говорящего справа сверху -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                        <Grid Width="72" Height="72" Margin="0,0,0,6">
                            <Ellipse x:Name="VoicePhotoCircle" Fill="#FFE4EBF2" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="VoicePhotoBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="VoiceInitials" FontSize="22" FontWeight="SemiBold"
                                       Foreground="#FF667085"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Button x:Name="PhotoButton" Content="Выбрать фото" Padding="10,4"
                                FontSize="12" IsEnabled="False" Click="OnChoosePhoto" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="PlayVoiceButton" Content="Прослушать" Padding="14,6" Margin="0,0,8,0"
                            IsEnabled="False" Click="OnPlayVoice" />
                    <Button x:Name="ForgetVoiceButton" Content="Забыть голос" Padding="14,6" Margin="0,0,8,0"
                            IsEnabled="False" Click="OnForgetVoice" />
                    <Button x:Name="SaveVoiceButton" Content="Сохранить" Padding="18,6"
                            FontWeight="SemiBold" IsEnabled="False" Click="OnSaveVoice" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Модели">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Модели распознавания" Style="{StaticResource Head}" />
                    <TextBlock x:Name="ModelsSubtitle" Style="{StaticResource Label}" TextWrapping="Wrap" />
                </StackPanel>

                <ListView x:Name="ModelList" Grid.Row="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Модель" Width="250" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Назначение" Width="300" DisplayMemberBinding="{Binding Purpose}" />
                            <GridViewColumn Header="Размер" Width="90" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="Состояние" Width="110" DisplayMemberBinding="{Binding State}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <TextBlock x:Name="ModelsPath" VerticalAlignment="Center" FontSize="11"
                               Foreground="#FF98A2B3" Margin="0,0,12,0" />
                    <Button x:Name="DownloadModelsButton" Content="Скачать недостающие" Padding="16,6"
                            FontWeight="SemiBold" Click="OnDownloadModels" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Последние встречи">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Последние встречи" Style="{StaticResource Head}" />
                    <TextBlock Text="Двойной щелчок открывает карточку встречи: там виден состав пакета и собирается ZIP."
                               Style="{StaticResource Label}" TextWrapping="Wrap" />
                </StackPanel>

                <ListView x:Name="MeetingList" Grid.Row="1" MouseDoubleClick="OnMeetingDoubleClick"
                          SelectionChanged="OnMeetingSelected">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Встреча" Width="450" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Когда" Width="140" DisplayMemberBinding="{Binding When}" />
                            <GridViewColumn Header="Размер" Width="100" DisplayMemberBinding="{Binding Size}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="OpenFolderButton" Content="Открыть папку" Padding="14,6" Margin="0,0,8,0"
                            IsEnabled="False" Click="OnOpenMeetingFolder" />
                    <Button x:Name="OpenCardButton" Content="Карточка встречи" Padding="16,6"
                            FontWeight="SemiBold" IsEnabled="False" Click="OnOpenMeeting" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
