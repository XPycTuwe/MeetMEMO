<Window x:Class="MeetMemo.App.SubtitleOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Height"
        Focusable="False">
    <!-- Стенограмма беседы: последние фразы списком, у каждой свой говорящий.
         Раньше строка была одна, и «назвать» можно было только последнего услышанного —
         а пока думаешь, кто это, он успевает договорить и начинает следующий. -->
    <Border Background="#B8000000" CornerRadius="10" Padding="14,10"
            HorizontalAlignment="Right">
        <StackPanel>
            <ItemsControl x:Name="Lines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Кто говорит: имя, «Вы» или вопрос, если голос незнаком -->
                            <TextBlock Grid.Column="0" Text="{Binding Who}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding WhoBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Top" Margin="0,0,10,0" />

                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                       FontFamily="Segoe UI" FontSize="14"
                                       Foreground="{Binding TextBrush}"
                                       TextWrapping="Wrap" MaxWidth="430" />

                            <!-- Действие по конкретной фразе, а не по «последней» -->
                            <Border Grid.Column="2" Background="#40FFFFFF" CornerRadius="4"
                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding ActionVisibility}">
                                <TextBlock Text="{Binding ActionLabel}"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#FFF3F6FA" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Пока никто не говорил: показываем, что стенограмма жива -->
            <StackPanel x:Name="IdleRow" Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#FFE53935" VerticalAlignment="Center"
                         Margin="0,0,10,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.25" Duration="0:0:0.9"
                                                     AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="слушаю…" FontFamily="Segoe UI" FontSize="14"
                           Foreground="#FFF3F6FA" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
