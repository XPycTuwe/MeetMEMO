<Window x:Class="MeetMemo.App.SubtitleOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Height"
        Focusable="False"
        IsHitTestVisible="False">
    <!-- Субтитры распознавания: подтверждают, что стенограмма пишется прямо сейчас.
         Читать их не предполагается — важно само движение текста, поэтому плашка
         намеренно приглушённая и клики сквозь неё проходят к окну под ней. -->
    <Border Background="#B0000000" CornerRadius="10" Padding="16,10"
            HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Точка живёт своей жизнью даже в тишине: пока она пульсирует,
                 видно, что распознавание работает, а не зависло. -->
            <Ellipse x:Name="PulseDot" Width="9" Height="9" Fill="#FFE53935"
                     VerticalAlignment="Top" Margin="0,6,11,0">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.25" Duration="0:0:0.9"
                                                 AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <StackPanel MaxWidth="820">
                <!-- Предыдущая реплика приглушена: она уже уходит, внимание на новой -->
                <TextBlock x:Name="PreviousLine" Text="" Visibility="Collapsed"
                           FontFamily="Segoe UI" FontSize="13" Foreground="#8CFFFFFF"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,3" />
                <TextBlock x:Name="CurrentLine" Text="слушаю…"
                           FontFamily="Segoe UI" FontSize="15" Foreground="#FFF3F6FA"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                <!-- Кто говорит и подтверждение. Строка появляется только когда голос
                     узнан или ждёт имени: в остальное время она бы только мешала. -->
                <StackPanel x:Name="SpeakerRow" Orientation="Horizontal" Visibility="Collapsed"
                            Margin="0,7,0,0" HorizontalAlignment="Right">
                    <TextBlock x:Name="SpeakerName" Text=""
                               FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold"
                               Foreground="#FF7FD1A8" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />

                    <Border x:Name="ConfirmButton" Background="#4D7FD1A8" CornerRadius="4"
                            Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Это он" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FFEAFBF3" />
                    </Border>

                    <Border x:Name="RejectButton" Background="#40FFFFFF" CornerRadius="4"
                            Padding="9,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RejectLabel" Text="Не он"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#FFF3F6FA" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
