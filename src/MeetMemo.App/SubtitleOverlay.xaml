<Window x:Class="MeetMemo.App.SubtitleOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Height"
        Focusable="False">
    <!-- Стенограмма беседы: последние фразы списком, у каждой свой говорящий.
         Раньше строка была одна, и «назвать» можно было только последнего услышанного —
         а пока думаешь, кто это, он успевает договорить и начинает следующий. -->
    <Border Background="#B8000000" CornerRadius="10" Padding="14,10"
            HorizontalAlignment="Right">
        <StackPanel>
            <!-- Шапка: за неё панель таскают, ею же сворачивают. Заголовок нужен
                 и как ручка: у окна нет рамки, хвататься больше не за что. -->
            <Grid x:Name="HeaderRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FFE53935"
                         VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.25" Duration="0:0:0.9"
                                                     AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <TextBlock x:Name="HeaderText" Grid.Column="1" Text="Стенограмма"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#99FFFFFF"
                           VerticalAlignment="Center" />

                <Border x:Name="CollapseButton" Tag="collapse" Grid.Column="2"
                        Background="#33FFFFFF"
                        CornerRadius="4" Padding="9,2" Margin="8,0,0,0">
                    <TextBlock x:Name="CollapseLabel" Text="Свернуть"
                               FontFamily="Segoe UI" FontSize="11" Foreground="#FFF3F6FA" />
                </Border>
            </Grid>

            <ItemsControl x:Name="Lines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Кто говорит: имя, «Вы» или вопрос, если голос незнаком -->
                            <TextBlock Grid.Column="0" Text="{Binding Who}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding WhoBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Top" Margin="0,0,10,0" />

                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                       FontFamily="Segoe UI" FontSize="14"
                                       Foreground="{Binding TextBrush}"
                                       TextWrapping="Wrap" MaxWidth="430" />

                            <!-- Действия по конкретной фразе, а не по «последней».
                                 «Это он» уточняет отпечаток усреднением: чем больше
                                 подтверждений, тем увереннее узнаётся голос дальше. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Top" Margin="10,0,0,0">
                                <Border Tag="confirm" Background="#4D7FD1A8" CornerRadius="4"
                                        Padding="8,2" Visibility="{Binding ConfirmVisibility}">
                                    <TextBlock Text="Это он"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#FFEAFBF3" />
                                </Border>

                                <Border Tag="rename" Background="#40FFFFFF" CornerRadius="4"
                                        Padding="8,2" Margin="6,0,0,0"
                                        Visibility="{Binding ActionVisibility}">
                                    <TextBlock Text="{Binding ActionLabel}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#FFF3F6FA" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Пока никто не говорил: показываем, что стенограмма жива -->
            <!-- Пульсирующая точка переехала в шапку: она нужна и в свёрнутом виде,
                 а две одинаковые точки на панели выглядели ошибкой. -->
            <StackPanel x:Name="IdleRow" Orientation="Horizontal">
                <TextBlock Text="слушаю…" FontFamily="Segoe UI" FontSize="14"
                           Foreground="#FFF3F6FA" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
