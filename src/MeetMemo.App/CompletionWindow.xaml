<Window x:Class="MeetMemo.App.CompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Встреча записана"
        Icon="Assets/app.ico"
        Height="420" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF7F8FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Встреча записана"
                   FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="#FF1F2937" />

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" FontFamily="Segoe UI" FontSize="13"
                       Foreground="#FF374151" TextWrapping="Wrap" />
            <TextBlock x:Name="PathText" FontFamily="Consolas" FontSize="12"
                       Foreground="#FF667085" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,14,0,0" Background="White" CornerRadius="6"
                BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Состав пакета" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#FF667085" Margin="0,0,0,6" />
                    <ItemsControl x:Name="FilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="#FF374151" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WarningsText" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Открыть папку" Padding="14,6" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" Click="OnOpenFolderClick" />
            <Button x:Name="ZipButton" Content="Собрать ZIP для Claude" Padding="16,6"
                    FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                    Click="OnCreateZipClick" />
            <Button Content="Закрыть" Padding="14,6" Margin="8,0,0,0"
                    FontFamily="Segoe UI" FontSize="13" IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
