<Window x:Class="MeetMemo.App.CompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Встреча записана"
        Icon="Assets/app.ico"
        Height="470" Width="620" MinWidth="420" MinHeight="370"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF7F8FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Название правится прямо здесь: сразу после встречи это первое, что хочется
                 сделать, и гонять человека в отдельный диалог ради одной строки незачем.
                 Раньше поле было без рамки и выглядело заголовком — по нему не было
                 видно, что название вообще можно менять. Теперь это обычное поле
                 с подписью: понятно с первого взгляда, без подсказок. -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Название встречи"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#FF667085"
                           Margin="2,0,0,4" />

                <TextBox x:Name="TitleBox" Text="Встреча"
                         FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"
                         Foreground="#FF1F2937" Padding="9,6"
                         VerticalContentAlignment="Center"
                         LostFocus="OnTitleCommitted" KeyDown="OnTitleKeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="BorderBrush" Value="#FFD0D5DD" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF98A2B3" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF2E74B5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock x:Name="HeaderText" Text="Встреча записана"
                           FontFamily="Segoe UI" FontSize="12" Foreground="#FF667085"
                           Margin="2,5,0,0" />
            </StackPanel>

            <!-- Главное действие карточки — наверху и особняком: внизу, в ряду с удалением,
                 оно терялось среди прочего. -->
            <Button x:Name="ZipButton" Grid.Column="1" Click="OnCreateZipClick"
                    VerticalAlignment="Center" Padding="12,7"
                    Background="#FF2E74B5" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Значок архива: короб с язычком и полосой замка -->
                                <Canvas Width="16" Height="16" VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Path Fill="White"
                                          Data="M1,3 L15,3 L15,6 L1,6 Z M2,7 L14,7 L14,14
                                                A1,1 0 0 1 13,15 L3,15 A1,1 0 0 1 2,14 Z" />
                                    <Rectangle Canvas.Left="7" Canvas.Top="8" Width="2" Height="3"
                                               Fill="#FF2E74B5" />
                                </Canvas>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D5A94" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="ZipLabel" Text="Собрать ZIP"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" FontFamily="Segoe UI" FontSize="13"
                       Foreground="#FF374151" TextWrapping="Wrap" />
            <TextBlock x:Name="PathText" FontFamily="Consolas" FontSize="12"
                       Foreground="#FF667085" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,14,0,0" Background="White" CornerRadius="6"
                BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Состав пакета" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#FF667085" Margin="0,0,0,6" />
                    <ItemsControl x:Name="FilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="#FF374151" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WarningsText" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Пока идёт разбор, архив собирать рано: в нём не будет ни имён говорящих,
             ни склеенных дублей снимков. Полоса показывает, что работа не встала. -->
        <StackPanel x:Name="ProcessingPanel" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProcessingText" Text=""
                       FontFamily="Segoe UI" FontSize="13" Foreground="#FF1F2937" />
            <TextBlock x:Name="ProcessingHint"
                       Text="Архив станет полнее, если дождаться: в нём появятся имена собеседников."
                       FontFamily="Segoe UI" FontSize="11" Foreground="#FF667085"
                       TextWrapping="Wrap" Margin="0,3,0,6" />
            <ProgressBar x:Name="ProcessingBar" Height="5" IsIndeterminate="True"
                         Foreground="#FF2E74B5" Background="#FFE4E7EC" BorderThickness="0" />
        </StackPanel>

        <!-- Три равные колонки: кнопки тянутся вместе с окном и никогда не переносятся.
             Перенос выглядел неопрятно, а места на три кнопки хватает всегда. -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Открыть папку" Padding="8,7" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" Click="OnOpenFolderClick" />
            <Button Grid.Column="1" Content="Переименовать" Padding="8,7" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" Click="OnRenameClick" />
            <Button Grid.Column="2" Content="Удалить" Padding="8,7"
                    FontFamily="Segoe UI" FontSize="13" Foreground="#FFB42318"
                    Click="OnDeleteClick" />
        </Grid>
    </Grid>
</Window>
