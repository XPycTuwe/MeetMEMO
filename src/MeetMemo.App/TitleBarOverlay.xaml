<Window x:Class="MeetMemo.App.TitleBarOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        Width="330" Height="150"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!-- Размер окна постоянный, меняется только видимость содержимого внутри.
         Так панель не прыгает: при SizeToContent WPF сам двигал окно, расширяя его
         вправо и вниз, и перетирал выставленную позицию.
         Фон окна не задан намеренно — прозрачные области не перехватывают мышь,
         и щелчки по заголовку чужого окна проходят насквозь. -->
    <Window.Resources>
        <Style TargetType="Button" x:Key="BarButton">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="#E62E74B5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D5A94" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Управление раскрывается вниз, а не влево: в узком заголовке (TrueConf, компактные
         окна) горизонтальная панель не помещалась и уезжала за край окна. Вниз места
         всегда достаточно — там окно самого приложения. -->
    <StackPanel x:Name="ContentRoot" Background="{x:Null}" HorizontalAlignment="Right">

        <!-- Строка в заголовке: только значок и кнопка снимка, чтобы влезало в любую шапку -->
        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" Height="22" Background="{x:Null}">

            <!-- Значок состояния: в покое серый, при записи красный, на паузе жёлтый -->
            <!-- Снимок — самое частое действие во время встречи, поэтому кнопка вынесена
                 наружу: разворачивать панель ради неё не нужно. Появляется только когда
                 идёт запись именно этого окна. -->
            <Button x:Name="QuickShotButton" Visibility="Collapsed"
                    Click="OnShotClick" Focusable="False"
                    Margin="0,0,4,0" Padding="0" BorderThickness="0"
                    Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QsBd" Background="#E62E74B5" CornerRadius="3"
                                Width="18" Height="18">
                            <!-- Значок фотоаппарата: корпус с объективом -->
                            <Canvas Width="12" Height="12" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Fill="White"
                                      Data="M5,1 L9,1 L10,2.5 L12.5,2.5 A1,1 0 0 1 13.5,3.5
                                            L13.5,11 A1,1 0 0 1 12.5,12 L1.5,12
                                            A1,1 0 0 1 0.5,11 L0.5,3.5 A1,1 0 0 1 1.5,2.5
                                            L4,2.5 Z" />
                                <Ellipse Canvas.Left="4.5" Canvas.Top="5" Width="5" Height="5"
                                         Fill="#FF2E74B5" />
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QsBd" Property="Background" Value="#FF1D5A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Заметки нужны и до записи — цифры и питч кладут заранее, — поэтому
                 кнопка видна всегда, в отличие от снимка. Стоит вплотную к значку:
                 так её место не съезжает, когда снимок появляется и пропадает. -->
            <Button x:Name="NotesButton" Click="OnNotesClick" Focusable="False"
                    Margin="0,0,4,0" Padding="0" BorderThickness="0"
                    Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NtBd" Background="#E62E74B5" CornerRadius="3"
                                Width="18" Height="18">
                            <!-- Листок с загнутым углом и строчками -->
                            <Canvas Width="12" Height="12" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Fill="White"
                                      Data="M2,0.5 L7.5,0.5 L10,3 L10,11.5 L2,11.5 Z" />
                                <Path Fill="#FF2E74B5" Data="M7.5,0.5 L10,3 L7.5,3 Z" />
                                <Rectangle Canvas.Left="3.5" Canvas.Top="5" Width="5"
                                           Height="0.9" Fill="#FF2E74B5" />
                                <Rectangle Canvas.Left="3.5" Canvas.Top="7" Width="5"
                                           Height="0.9" Fill="#FF2E74B5" />
                                <Rectangle Canvas.Left="3.5" Canvas.Top="9" Width="3"
                                           Height="0.9" Fill="#FF2E74B5" />
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NtBd" Property="Background" Value="#FF1D5A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Значок можно таскать по заголовку: у каждого приложения свои кнопки
                 слева от системных, и единого правильного места не существует.
                 Прозрачный фон мышью не ловится — нужен явный Transparent. -->
            <!-- Мышь на значке отслеживается опросом координат, а не событиями WPF:
                 у окна без активации и с прозрачным фоном события до содержимого
                 не доходят — щелчок по значку просто не замечался. -->
            <Grid x:Name="Badge" Width="16" Height="16" Margin="0,0,2,0"
                  VerticalAlignment="Center" Background="Transparent">
                <Ellipse x:Name="BadgeRing" Width="15" Height="15"
                         Stroke="#B39CA3AF" StrokeThickness="1.5" Fill="#33FFFFFF" />
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF9CA3AF" />
            </Grid>
        </StackPanel>

        <!-- Выпадающее управление. Открывается щелчком по значку: при открытии
             по наведению панель выскакивала от случайного движения мыши. -->
        <Border x:Name="ControlsPanel" Visibility="Collapsed"
                Background="#F51F2937" CornerRadius="6" Padding="8,7"
                Margin="0,3,0,0" HorizontalAlignment="Right">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="MeetMemo"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#FF9CA3AF"
                           Margin="2,0,2,6" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RecordButton" Content="Записать"
                            Style="{StaticResource BarButton}" Click="OnRecordClick" />
                    <Button x:Name="PauseButton" Content="Пауза" Visibility="Collapsed"
                            Style="{StaticResource BarButton}" Click="OnPauseClick" />
                    <Button x:Name="ShotButton" Content="Снимок" Visibility="Collapsed"
                            Style="{StaticResource BarButton}" Click="OnShotClick" />
                    <Button x:Name="ImportantButton" Content="Важно" Visibility="Collapsed"
                            Style="{StaticResource BarButton}" Click="OnImportantClick" />
                </StackPanel>

                <!-- Автоснимки можно выключить прямо во время встречи: например,
                     когда на экране появляется то, чему не место в пакете -->
                <CheckBox x:Name="AutoShotsBox" Visibility="Collapsed"
                          Content="Автоснимки экрана" Focusable="False"
                          FontFamily="Segoe UI" FontSize="11" Foreground="#FFD1D5DB"
                          Margin="2,8,2,0"
                          Checked="OnAutoShotsToggled" Unchecked="OnAutoShotsToggled" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
