<Window x:Class="MeetMemo.App.TitleBarOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        Width="460" Height="28"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!-- Размер окна постоянный, меняется только видимость содержимого внутри.
         Так панель не прыгает: при SizeToContent WPF сам двигал окно, расширяя его
         вправо и вниз, и перетирал выставленную позицию.
         Фон окна не задан намеренно — прозрачные области не перехватывают мышь,
         и щелчки по заголовку чужого окна проходят насквозь. -->
    <Window.Resources>
        <Style TargetType="Button" x:Key="BarButton">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="#E62E74B5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D5A94" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- LastChildFill обязательно False: иначе единственный ребёнок растягивается на всю
         ширину окна, его содержимое прижимается влево, и разворот управления начинает
         толкать значок вправо. Значок должен стоять на одном месте всегда. -->
    <DockPanel x:Name="ContentRoot" Background="{x:Null}" LastChildFill="False">

        <StackPanel x:Name="ButtonsPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Center" Background="{x:Null}">

            <Border x:Name="ControlsPanel" Visibility="Collapsed"
                    Background="#F21F2937" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="MeetMemo"
                               FontFamily="Segoe UI" FontSize="11" Foreground="#FFD1D5DB"
                               VerticalAlignment="Center" Margin="4,0,6,0" />
                    <Button x:Name="RecordButton" Content="Записать"
                            Style="{StaticResource BarButton}" Click="OnRecordClick" />
                    <Button x:Name="PauseButton" Content="Пауза" Visibility="Collapsed"
                            Style="{StaticResource BarButton}" Click="OnPauseClick" />
                    <Button x:Name="ShotButton" Content="Снимок" Visibility="Collapsed"
                            Style="{StaticResource BarButton}" Click="OnShotClick" />
                    <Button x:Name="ImportantButton" Content="Важно" Visibility="Collapsed"
                            Style="{StaticResource BarButton}" Click="OnImportantClick" />
                    <!-- Автоснимки можно выключить прямо во время встречи: например,
                         когда на экране появляется то, чему не место в пакете -->
                    <CheckBox x:Name="AutoShotsBox" Visibility="Collapsed"
                              Content="Автоснимки экрана" Focusable="False"
                              FontFamily="Segoe UI" FontSize="11" Foreground="#FFD1D5DB"
                              VerticalAlignment="Center" Margin="8,0,4,0"
                              Checked="OnAutoShotsToggled" Unchecked="OnAutoShotsToggled" />
                </StackPanel>
            </Border>

            <!-- Значок состояния: в покое серый, при записи красный, на паузе жёлтый -->
            <!-- Снимок — самое частое действие во время встречи, поэтому кнопка вынесена
                 наружу: разворачивать панель ради неё не нужно. Появляется только когда
                 идёт запись именно этого окна. -->
            <Button x:Name="QuickShotButton" Visibility="Collapsed"
                    Click="OnShotClick" Focusable="False"
                    Margin="0,0,4,0" Padding="0" BorderThickness="0"
                    Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QsBd" Background="#E62E74B5" CornerRadius="4"
                                Width="22" Height="22">
                            <!-- Значок фотоаппарата: корпус с объективом -->
                            <Canvas Width="14" Height="14" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Fill="White"
                                      Data="M5,1 L9,1 L10,2.5 L12.5,2.5 A1,1 0 0 1 13.5,3.5
                                            L13.5,11 A1,1 0 0 1 12.5,12 L1.5,12
                                            A1,1 0 0 1 0.5,11 L0.5,3.5 A1,1 0 0 1 1.5,2.5
                                            L4,2.5 Z" />
                                <Ellipse Canvas.Left="4.5" Canvas.Top="5" Width="5" Height="5"
                                         Fill="#FF2E74B5" />
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QsBd" Property="Background" Value="#FF1D5A94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Grid x:Name="Badge" Width="20" Height="20" Margin="0,0,2,0"
                  VerticalAlignment="Center" Background="{x:Null}">
                <Ellipse x:Name="BadgeRing" Width="18" Height="18"
                         Stroke="#B39CA3AF" StrokeThickness="1.5" Fill="#33FFFFFF" />
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF9CA3AF" />
            </Grid>
        </StackPanel>

        <!-- Здесь была строка распознанной речи. Она уползала влево по чужому заголовку
             и мешала самому заголовку; теперь стенограмма видна в субтитрах внизу экрана. -->
    </DockPanel>
</Window>
