<Window x:Class="MeetMemo.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименовать встречу"
        Icon="Assets/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F8FA">
    <StackPanel Margin="18">
        <TextBlock Text="Новое название встречи"
                   FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#FF1F2937" />
        <TextBlock Text="Переименуется и папка, и название внутри пакета — оно попадёт в мемо."
                   FontFamily="Segoe UI" FontSize="12" Foreground="#FF667085"
                   TextWrapping="Wrap" Margin="0,4,0,12" />

        <TextBox x:Name="TitleBox" Padding="6,5" FontFamily="Segoe UI" FontSize="14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Padding="14,6" Margin="0,0,8,0"
                    FontFamily="Segoe UI" FontSize="13" IsCancel="True" Click="OnCancel" />
            <Button Content="Переименовать" Padding="18,6"
                    FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                    IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
