<Window x:Class="MeetMemo.App.ScreenshotConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        Width="290" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!-- Карточки ожидающих снимков: миниатюра, свой отсчёт и отказ. Появляются под
         значком MeetMemo, самая старая сверху — она и уйдёт первой. -->
    <ItemsControl x:Name="PendingList" HorizontalAlignment="Right">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="#F51F2937" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#FF3A4C63" BorderThickness="1" CornerRadius="3">
                            <Image Source="{Binding Thumbnail}" Width="86" Height="52"
                                   Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center" Width="160">
                            <TextBlock Text="Экран сменился — снимок сделан"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#FFD1D5DB"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Countdown}"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#FF9CA3AF"
                                       Margin="0,3,0,5" />
                            <Border x:Name="CancelBox" Background="#33FFFFFF" CornerRadius="3"
                                    Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="Не сохранять"
                                           FontFamily="Segoe UI" FontSize="11" Foreground="#FFF3F6FA" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
