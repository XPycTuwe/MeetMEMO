<Window x:Class="MeetMemo.App.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки — MeetMemo"
        Icon="Assets/app.ico"
        Width="360" Height="420" MinWidth="240" MinHeight="180"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1B1D22">
    <!-- Блокнот поверх встречи: ключевые цифры, питч, что вспомнилось по ходу.
         Держится поверх окон и не попадает в снимки — это личное, а не материал
         пакета для чужих глаз. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="Editor" Grid.Row="0"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 SpellCheck.IsEnabled="True" Language="ru-ru"
                 BorderThickness="0" Padding="6,4"
                 Background="Transparent"
                 TextChanged="OnTextChanged" />

        <!-- Управление внизу: наверху оно отбирало бы место у самого текста -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="А−" Width="34" Padding="0,3"
                    ToolTip="Мельче" Click="OnSmaller" />
            <Button Grid.Column="1" Content="А+" Width="34" Padding="0,3" Margin="4,0,0,0"
                    ToolTip="Крупнее" Click="OnBigger" />
            <Button x:Name="ThemeButton" Grid.Column="2" Padding="10,3" Margin="8,0,0,0"
                    ToolTip="Контраст текста" Click="OnCycleTheme" />

            <!-- Подпись прижата вправо и обрезается многоточием: в узком окне она
                 иначе налезала на кнопку смены контраста. -->
            <TextBlock x:Name="HintText" Grid.Column="4"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="8,0,6,0" FontSize="11" Opacity="0.65"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="Заметки одни на все встречи и попадают в пакет — модель увидит, что вы считали важным" />
        </Grid>
    </Grid>
</Window>
