<Window x:Class="MeetMemo.App.SpeakerCardOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetMemo"
        Width="240" Height="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <!-- Кто говорит прямо сейчас. Висит справа сверху, отдельно от стенограммы внизу:
         так видно говорящего, даже когда на текст не смотришь. -->
    <Border Background="#D9101C28" CornerRadius="6" Padding="8,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" Text=""
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFF3F6FA" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RoleText" Text="" Visibility="Collapsed"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#FF9CA3AF" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Фото, если есть; иначе кружок с инициалами -->
            <Grid Grid.Column="1" Width="30" Height="30" Margin="8,0,0,0">
                <Ellipse x:Name="PhotoCircle">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="InitialsCircle" Fill="#FF2E74B5" />
                <TextBlock x:Name="InitialsText" Text=""
                           FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
